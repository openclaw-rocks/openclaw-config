{
  "agents": {
    "defaults": {
      "maxConcurrent": 4,
      "model": {
        "primary": "fuel/worker",
        "fallbacks": ["fuel/reasoning"]
      },
      "subagents": {
        "maxConcurrent": 8,
        "model": {
          "primary": "fuel/worker"
        }
      },
      "heartbeat": {
        "every": "1h",
        "model": "fuel/heartbeat"
      },
      "contextPruning": {
        "mode": "cache-ttl",
        "ttl": "6h",
        "keepLastAssistants": 3
      },
      "compaction": {
        "reserveTokensFloor": 20000,
        "memoryFlush": {
          "enabled": true,
          "softThresholdTokens": 40000,
          "prompt": "Extract key decisions, state changes, lessons, and blockers to memory/YYYY-MM-DD.md. Format: ## [HH:MM] Topic. Skip routine work. Output NO_FLUSH if nothing important happened.",
          "systemPrompt": "Compacting session context. Extract only what is worth remembering. No fluff, no routine operations."
        }
      },
      "memorySearch": {
        "enabled": true,
        "sources": ["memory", "sessions"],
        "provider": "fuel",
        "model": "text-embedding-3-small",
        "experimental": { "sessionMemory": true }
      }
    }
  },
  "messages": {
    "ackReactionScope": "group-all"
  },
  "models": {
    "mode": "merge",
    "providers": {
      "fuel": {
        "baseUrl": "http://fuel-proxy.openclawrocks.svc.cluster.local:8080/v1",
        "apiKey": "${BIFROST_VIRTUAL_KEY}",
        "api": "openai-completions",
        "models": [
          {
            "id": "worker",
            "name": "Fuel Worker",
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
            "contextWindow": 163840
          },
          {
            "id": "reasoning",
            "name": "Fuel Reasoning",
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
            "contextWindow": 262144
          },
          {
            "id": "heartbeat",
            "name": "Fuel Heartbeat",
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
            "contextWindow": 131072
          },
          {
            "id": "audio",
            "name": "Fuel Audio",
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
            "contextWindow": 32768
          },
          {
            "id": "text-embedding-3-small",
            "name": "Text Embedding 3 Small",
            "cost": { "input": 0, "output": 0 },
            "contextWindow": 8191
          }
        ]
      }
    }
  },
  "commands": {
    "restart": true
  },
  "hooks": {
    "internal": {
      "enabled": true,
      "entries": {
        "boot-md": { "enabled": true },
        "session-memory": { "enabled": true }
      }
    }
  },
  "tools": {
    "profile": "full",
    "media": {
      "audio": {
        "enabled": true,
        "models": [
          { "provider": "fuel", "model": "whisper-1", "capabilities": ["audio"] }
        ]
      }
    }
  },
  "gateway": {
    "bind": "loopback"
  },
  "logging": {
    "redactSensitive": "tools"
  }
}
